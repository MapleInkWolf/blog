---
import '@fontsource-variable/saira/standard.css';
import '@fontsource-variable/noto-sans-sc/wght.css';
import { SITE, NAV } from '../site.config';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
}

const {
  title,
  description = SITE.tagline,
  type = 'website',
  published,
} = Astro.props;

const pageTitle = title ? `${title} / ${SITE.title}` : `${SITE.title} / ${SITE.tagline}`;
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';

const isActive = (href: string) => {
  if (href.startsWith('http')) return false;
  const target = withBase(href).replace(/\/+$/, '') || '/';
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
};

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} / RSS`}
      href={withBase('/rss.xml')}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f4f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191919" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}

    <link rel="stylesheet" href={withBase('/endfield.css')} />
    <link rel="stylesheet" href={withBase('/site.css')} />

    <script is:inline>
      // 首帧之前定好主题，避免闪一下
      (() => {
        try {
          var saved = localStorage.getItem('theme');
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body class="ef ef-contours">
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="ef-tri ef-in-sweep" aria-hidden="true"><i></i><i></i><i></i></div>

    <header class="site-bar">
      <a class="brand" href={withBase('/')}>{SITE.title}</a>
      <nav class="site-nav" aria-label="主导航">
        {NAV.map((item) => (
          <a
            href={'external' in item && item.external ? item.href : withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[{ 'nav-ext': 'external' in item && item.external }]}
            {...('external' in item && item.external
              ? { target: '_blank', rel: 'noopener' }
              : {})}
          >
            {item.label}
          </a>
        ))}
        <button class="ef-btn small" type="button" data-theme-toggle aria-pressed="false">
          切换深浅
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="site-foot__inner">
        <p class="ef-field">
          <span>© {year} {SITE.author}</span>
          <span>GitHub Pages</span>
        </p>
        <nav class="ef-field" aria-label="其他链接">
          <a href={withBase('/rss.xml')}>RSS</a>
          <a href={SITE.bilibili.space} target="_blank" rel="noopener">B站</a>
          <a href={SITE.bilibili.live} target="_blank" rel="noopener">直播</a>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href={withBase('/license.txt')}>License</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (() => {
        var root = document.documentElement;
        var btn = document.querySelector('[data-theme-toggle]');
        if (!btn) return;
        btn.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
        btn.addEventListener('click', () => {
          var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          btn.setAttribute('aria-pressed', String(next === 'dark'));
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* 隐私模式存不了，忽略 */
          }
        });
      })();
    </script>
  </body>
</html>
