---
import '@fontsource-variable/saira/standard.css';
import '@fontsource-variable/noto-sans-sc/wght.css';
import { ClientRouter } from 'astro:transitions';
import PlayerBar from '../components/PlayerBar.astro';
import { SITE, NAV } from '../site.config';
import { withBase } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.tagline,
  type = 'website',
  published,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} / ${SITE.title}` : `${SITE.title} / ${SITE.tagline}`;
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).href;
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

// 去掉 base 前缀再比较，否则 /blog/ 会把每个页面都算成首页
const rel = base && current.startsWith(base) ? current.slice(base.length) || '/' : current;

const isActive = (href: string) => {
  if (href.startsWith('http')) return false;
  if (href === '/') return rel === '/';
  const target = href.replace(/\/+$/, '');
  return rel === target || rel.startsWith(`${target}/`);
};

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} / RSS`}
      href={withBase('/rss.xml')}
    />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f4f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191919" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}

    <link rel="stylesheet" href={withBase('/endfield.css')} />
    <link rel="stylesheet" href={withBase('/site.css')} />

    <ClientRouter />

    <script is:inline>
      // 首帧之前定好主题，避免闪一下
      (() => {
        try {
          var saved = localStorage.getItem('theme');
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = saved || (dark ? 'dark' : 'light');
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body class="ef ef-contours">
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="ef-tri ef-in-sweep" aria-hidden="true"><i></i><i></i><i></i></div>

    <header class="site-bar">
      <a class="brand" href={withBase('/')}>{SITE.title}</a>
      <nav class="site-nav" aria-label="主导航">
        {NAV.map((item) => (
          <a
            href={'external' in item && item.external ? item.href : withBase(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[{ 'nav-ext': 'external' in item && item.external }]}
            {...('external' in item && item.external
              ? { target: '_blank', rel: 'noopener' }
              : {})}
          >
            {item.label}
          </a>
        ))}
        <a
          class="nav-admin"
          href={withBase('/admin/')}
          aria-current={isActive('/admin/') ? 'page' : undefined}
          data-owner-only
          hidden>控制台</a
        >
        <button class="ef-btn small" type="button" data-theme-toggle aria-pressed="false">
          切换深浅
        </button>
      </nav>

      <PlayerBar />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="site-foot__inner">
        <p class="ef-field">
          <span>© {year} {SITE.author}</span>
          <span>GitHub Pages</span>
        </p>
        <nav class="ef-field" aria-label="其他链接">
          <a href={withBase('/rss.xml')}>RSS</a>
          <a href={withBase('/music/')}>歌单</a>
          <a href={SITE.bilibili.space} target="_blank" rel="noopener">B站</a>
          <a href={SITE.bilibili.live} target="_blank" rel="noopener">直播</a>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href={withBase('/license.txt')}>License</a>
        </nav>
      </div>
    </footer>

    <script>
      import '../scripts/player.js';

      /* ---------- 页面级初始化：每次站内跳转后重跑 ---------- */

      const initDecode = () => {
        const code = document.querySelector('[data-decode]');
        if (!code || code.dataset.decoded === '1') return;
        code.dataset.decoded = '1';

        const bar = code.parentElement ? code.parentElement.querySelector('.hud-bar') : null;
        const target = code.getAttribute('data-decode') || '';
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        const settle = () => {
          code.textContent = target;
          code.classList.add('is-done');
          if (bar) bar.classList.add('is-full');
        };

        if (reduce || !target) {
          settle();
          return;
        }

        const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#/+=';
        const total = 26;
        const scramble = (str) =>
          Array.from(str, (ch) => (ch === ' ' ? ' ' : glyphs[Math.floor(Math.random() * glyphs.length)])).join('');

        code.textContent = scramble(target);
        setTimeout(() => {
          let frame = 0;
          const timer = setInterval(() => {
            frame++;
            const done = Math.floor((frame / total) * target.length);
            code.textContent = target.slice(0, done) + scramble(target.slice(done));
            if (frame >= total) {
              clearInterval(timer);
              settle();
            }
          }, 24);
        }, 320);
      };

      const initToc = () => {
        const links = Array.from(document.querySelectorAll('.toc a'));
        const sections = document.querySelectorAll('.ef-prose h2[id], .ef-prose h3[id]');
        if (!links.length || !sections.length) return;

        const byId = new Map(links.map((a) => [a.getAttribute('href').slice(1), a]));
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              links.forEach((a) => a.removeAttribute('aria-current'));
              const link = byId.get(entry.target.id);
              if (link) link.setAttribute('aria-current', 'true');
            });
          },
          { rootMargin: '0px 0px -70% 0px' },
        );
        sections.forEach((section) => observer.observe(section));
      };

      const initPage = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(dark));
        });

        // 只有本机存过 token（也就是站主）才看得到控制台入口
        let owner = false;
        try {
          owner = Boolean(localStorage.getItem('blog.gh.token'));
        } catch {
          owner = false;
        }
        document.querySelectorAll('[data-owner-only]').forEach((el) => {
          el.hidden = !owner;
        });

        initDecode();
        initToc();
      };

      // 主题切换用事件委托：站内跳转后按钮会被重建，不用重新绑定
      document.addEventListener('click', (event) => {
        const el = event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null;
        if (!el) return;
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        el.setAttribute('aria-pressed', String(next === 'dark'));
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* 无痕模式 */
        }
      });

      document.addEventListener('astro:page-load', initPage);
      initPage();
    </script>
  </body>
</html>
