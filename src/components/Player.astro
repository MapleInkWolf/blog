---
import { PLAYLIST, fmtDuration, totalDuration } from '../data/playlist';

const first = PLAYLIST.tracks[0];
const playerSrc = (id: string, auto: 0 | 1) =>
  `https://music.163.com/outchain/player?type=2&id=${id}&auto=${auto}&height=66`;
---

<section class="pl" id="playlist" aria-labelledby="pl-name">
  <div class="pl-top">
    <div>
      <p class="ef-eyebrow slash">Playlist</p>
      <h2 class="pl-name" id="pl-name">{PLAYLIST.name}</h2>
      <p class="ef-field pl-meta">
        <span>{PLAYLIST.tracks.length} 首</span>
        <span>共 {totalDuration()}</span>
        <span>网易云音乐</span>
      </p>
    </div>
    <a class="ef-btn small" href={PLAYLIST.url} target="_blank" rel="noopener">整张歌单</a>
  </div>

  <div class="pl-slot">
    <div class="pl-now">
      <p class="ef-field">正在播放</p>
      <p class="pl-now-title" id="pl-now-title">还没有选曲，点下面任意一首开始</p>
    </div>
    <iframe
      id="pl-frame"
      class="pl-frame"
      src={playerSrc(first.id, 0)}
      title="网易云音乐播放器"
      height="66"
      frameborder="0"
      allow="autoplay; encrypted-media"
      loading="lazy"></iframe>
  </div>

  <ol class="ef-records pl-list">
    {PLAYLIST.tracks.map((track, i) => {
      const no = String(i + 1).padStart(2, '0');
      return (
        <li>
          <button
            type="button"
            class="ef-record pl-row"
            data-song={track.id}
            data-no={no}
            data-title={track.title}
            aria-pressed="false"
            aria-label={`播放 No.${no} ${track.title}，${track.artist}`}
          >
            <span class="ef-tag">No.{no}</span>
            <span class="name ef-read">{track.title}</span>
            <span class="pl-artist ef-field">{track.artist}</span>
            <span class="ef-field">{fmtDuration(track.duration)}</span>
          </button>
        </li>
      );
    })}
  </ol>

  <p class="ef-empty pl-note">
    播放器由网易云音乐提供，点一行就换一首；需要登录或会员的曲目，会在播放器里提示。
  </p>
</section>

<script is:inline>
  (() => {
    var frame = document.getElementById('pl-frame');
    var now = document.getElementById('pl-now-title');
    var rows = Array.prototype.slice.call(document.querySelectorAll('.pl-row'));
    if (!frame || !rows.length) return;

    rows.forEach(function (row) {
      row.addEventListener('click', function () {
        rows.forEach(function (r) {
          r.classList.remove('is-playing');
          r.setAttribute('aria-pressed', 'false');
        });
        row.classList.add('is-playing');
        row.setAttribute('aria-pressed', 'true');

        var id = row.getAttribute('data-song');
        var no = row.getAttribute('data-no');
        var title = row.getAttribute('data-title');

        // 换 iframe 的 src 就会重新加载并自动播放这一首
        frame.src =
          'https://music.163.com/outchain/player?type=2&id=' +
          encodeURIComponent(id) +
          '&auto=1&height=66';

        if (now) now.textContent = 'No.' + no + ' · ' + title;
      });
    });
  })();
</script>
