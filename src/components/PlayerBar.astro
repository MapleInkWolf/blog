---
import { PLAYLIST } from '../data/playlist';
import { withBase } from '../lib/url';

const tracks = PLAYLIST.tracks.map(({ id, title, artist, duration, cover }) => ({
  id,
  title,
  artist,
  duration,
  cover,
}));

const first = tracks[0];
---

<div class="pbar" id="pbar" transition:persist="player">
  <script type="application/json" id="pl-data" set:html={JSON.stringify(tracks)} />

  <a class="pbar__cover" href={withBase('/music/')} aria-label="打开歌单">
    <img
      data-player-cover
      src={first.cover}
      alt=""
      width="34"
      height="34"
      referrerpolicy="no-referrer"
      decoding="async"
    />
    <span class="pbar__bars" aria-hidden="true"><i></i><i></i><i></i></span>
  </a>

  <span class="pbar__meta">
    <a class="pbar__title" data-player-title href={withBase('/music/')}>No.01 · {first.title}</a>
    <span class="pbar__artist" data-player-artist>{first.artist}</span>
  </span>

  <span class="pbar__ctrl">
    <button type="button" class="pbtn" data-player="prev" aria-label="上一首">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" fill="currentColor" /></svg>
    </button>
    <button
      type="button"
      class="pbtn pbtn--main"
      data-player="toggle"
      data-player-toggle
      aria-label="播放"
      aria-pressed="false"
    >
      <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
      <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" /></svg>
    </button>
    <button type="button" class="pbtn" data-player="next" aria-label="下一首">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5h2v14h-2zM4 5v14l11-7z" fill="currentColor" /></svg>
    </button>
  </span>

  <span class="pbar__line" data-player-seek role="slider" tabindex="-1" aria-label="播放进度">
    <i data-player-fill></i>
  </span>

  <span class="pbar__err" data-player-error hidden>
    音频没取到 · <a data-player-link href="https://music.163.com" target="_blank" rel="noopener">去网易云</a>
  </span>
</div>
