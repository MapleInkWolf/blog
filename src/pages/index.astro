---
import Base from '../layouts/Base.astro';
import Player from '../components/Player.astro';
import { SITE } from '../site.config';
import { withBase } from '../lib/url';
import {
  getEntries,
  newestFirst,
  formatDate,
  isoDate,
  num,
  readingMinutes,
  tagCounts,
} from '../lib/posts';

const entries = await getEntries();
const posts = newestFirst(entries);
const latest = posts[0];
const totalWords = entries.reduce((sum, e) => sum + e.words, 0);
const tags = tagCounts(entries);
const today = new Date();
const ticker = posts.slice(0, 6);
const index = posts.slice(0, SITE.indexCount);
---

<Base description={SITE.description}>
  <section class="hero">
    <p class="meta ef-field">
      <time datetime={isoDate(today)}>{formatDate(today)}</time>
      <span><b>{entries.length}</b> 篇</span>
      <span><b>{num(totalWords)}</b> 字</span>
      <span><b>{tags.length}</b> 个标签</span>
    </p>

    <h1 class="ef-wordmark">
      <span class="solid ef-in-drive">{SITE.wordmark.solid}</span>
      <span class="hollow ef-in-drive" style="animation-delay: 140ms" aria-hidden="true">
        {SITE.wordmark.hollow}
      </span>
      <span class="sr-only">{SITE.title}</span>
    </h1>

    <div class="copy">
      <p class="claim"><span class="ef-marker ef-in-stroke">{SITE.claim}</span></p>
      <p class="bio">{SITE.description}</p>
      <p class="ef-actions">
        {latest && (
          <a class="ef-btn go" href={withBase(`/posts/${latest.post.id}/`)}>
            读最新一篇 <span class="sub">No.{latest.no}</span>
          </a>
        )}
        <a class="ef-btn" href={withBase('/posts/')}>全部文章</a>
        <a class="ef-btn" href={SITE.bilibili.live} target="_blank" rel="noopener">直播间</a>
      </p>
    </div>

    <figure class="ef-frame">
      <div class="window">
        <img
          class="shot"
          src={withBase('/images/eku.jpg')}
          alt="插画：抱着甜甜圈的 EKU"
          width="1200"
          height="1000"
        />
        <span class="frame-scan" aria-hidden="true"></span>
        <span class="frame-hud" aria-hidden="true">
          <span class="hud-code" data-decode="ARCHIVE / 01">ARCHIVE / 01</span>
          <span class="hud-bar"></span>
        </span>
      </div>
      <figcaption class="ef-plate">技术、阅读与直播间的档案。</figcaption>
    </figure>

    <div class="ef-ticker" aria-label="最近的文章">
      <div class="track">
        <ul>
          {ticker.map((e) => (
            <li>
              <a href={withBase(`/posts/${e.post.id}/`)}>
                <b>No.{e.no}</b>{e.post.data.title}
              </a>
            </li>
          ))}
        </ul>
        <ul aria-hidden="true">
          {ticker.map((e) => (
            <li>
              <a href={withBase(`/posts/${e.post.id}/`)} tabindex="-1">
                <b>No.{e.no}</b>{e.post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {latest && (
    <section class="latest">
      <a href={withBase(`/posts/${latest.post.id}/`)}>
        <span class="ef-hollow-no" aria-hidden="true">{latest.no}</span>
        <span class="body">
          <span class="ef-field">
            <span class="flag">最新</span>
            {formatDate(latest.post.data.date)} | {num(latest.words)} 字 | 约 {readingMinutes(latest.words)} 分钟
          </span>
          <span class="title">{latest.post.data.title}</span>
          <span class="cap">{latest.post.data.description}</span>
          <span class="ef-btn go">阅读全文</span>
        </span>
      </a>
    </section>
  )}

  <section class="index">
    <p class="ef-eyebrow slash">Index</p>
    <h2 class="ef-bar-title">全站索引</h2>
    <ol class="ef-records">
      {index.map((e, i) => (
        <li>
          <a class="ef-record ef-in-come" style={`--i: ${i}`} href={withBase(`/posts/${e.post.id}/`)}>
            <span class="ef-tag">No.{e.no}</span>
            <time class="ef-field" datetime={isoDate(e.post.data.date)}>{formatDate(e.post.data.date)}</time>
            <span class="name ef-read">{e.post.data.title}</span>
            <span class="ef-field">{num(e.words)} 字</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="ef-actions index-foot">
      <a class="ef-btn" href={withBase('/posts/')}>全部 {entries.length} 篇</a>
    </p>
  </section>

  <Player />

  <section class="channels" aria-label="B站">
    <p class="ef-eyebrow slash" style="grid-column: 1 / -1; margin: 0 0 -0.25rem">
      Channels / 频道
    </p>
    <a class="channel" href={SITE.bilibili.space} target="_blank" rel="noopener">
      <span class="ef-field">Bilibili / Video</span>
      <b>视频空间</b>
      <span class="ef-field">space.bilibili.com/44972013</span>
    </a>
    <a class="channel" href={SITE.bilibili.live} target="_blank" rel="noopener">
      <span class="ef-field">Bilibili / Live</span>
      <b>直播间</b>
      <span class="ef-field">live.bilibili.com/2132018</span>
    </a>
  </section>
  <script is:inline>
    // 右上角 ARCHIVE / 01：乱码滚动后落定，然后色条长满
    (() => {
      var code = document.querySelector('[data-decode]');
      if (!code) return;
      var bar = document.querySelector('.hud-bar');
      var target = code.getAttribute('data-decode') || '';
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function settle() {
        code.textContent = target;
        code.classList.add('is-done');
        if (bar) bar.classList.add('is-full');
      }

      if (reduce || !target) {
        settle();
        return;
      }

      var glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#/+=';
      var total = 26;

      function scramble(str) {
        var out = '';
        for (var i = 0; i < str.length; i++) {
          var ch = str.charAt(i);
          out += ch === ' ' ? ' ' : glyphs.charAt(Math.floor(Math.random() * glyphs.length));
        }
        return out;
      }

      // 先铺一层乱码，等首屏画出来再落定——不然动效在图片加载前就跑完了
      code.textContent = scramble(target);
      setTimeout(function () {
        var frame = 0;
        var timer = setInterval(function () {
          frame++;
          var done = Math.floor((frame / total) * target.length);
          var out = target.slice(0, done);
          for (var i = done; i < target.length; i++) {
            var ch = target.charAt(i);
            out +=
              ch === ' '
                ? ' '
                : glyphs.charAt(Math.floor(Math.random() * glyphs.length));
          }
          code.textContent = out;
          if (frame >= total) {
            clearInterval(timer);
            settle();
          }
        }, 24);
      }, 320);
    })();
  </script>
</Base>
