---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import { formatDate, isoDate, readingTime } from '../../lib/format';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// 按年份分组，方便一眼看出写作节奏
const byYear = posts.reduce<Record<string, typeof posts>>((acc, post) => {
  const year = String(post.data.date.getFullYear());
  (acc[year] ??= []).push(post);
  return acc;
}, {});
const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));
---

<Base title="文章" description={`${posts.length} 篇文章的归档。`}>
  <h1 class="page-title">文章</h1>

  {years.map((year) => (
    <section>
      <h2 class="year-heading">{year}</h2>
      <ul class="post-list">
        {byYear[year].map((post) => (
          <li>
            <a class="post-item" href={withBase(`/posts/${post.id}/`)}>
              <span class="post-item__title">{post.data.title}</span>
              <span class="post-item__meta">
                <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
                <span>{readingTime(post.body ?? '')}</span>
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {posts.length === 0 && <p>还没有文章。</p>}
</Base>
