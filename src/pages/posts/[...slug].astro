---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/url';
import { formatDate, isoDate, readingTime } from '../../lib/format';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[index + 1] ?? null,
      next: posts[index - 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  prev: CollectionEntry<'posts'> | null;
  next: CollectionEntry<'posts'> | null;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
---

<Base
  title={post.data.title}
  description={post.data.description || post.data.title}
  type="article"
  published={post.data.date}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
        <span>·</span>
        <span>大约 {minutes}</span>
        {post.data.tags.length > 0 && (
          <span class="post-meta__tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </span>
        )}
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  {(prev || next) && (
    <nav class="post-nav" aria-label="上下篇">
      {prev ? (
        <a class="post-nav__link" href={withBase(`/posts/${prev.id}/`)}>
          <span class="post-nav__label">← 上一篇</span>
          <span class="post-nav__title">{prev.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="post-nav__link post-nav__link--next" href={withBase(`/posts/${next.id}/`)}>
          <span class="post-nav__label">下一篇 →</span>
          <span class="post-nav__title">{next.data.title}</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )}
</Base>
